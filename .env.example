# Copy to .env and replace the password. .env is ignored by Git.
DB_URL=jdbc:mysql://127.0.0.1:3306/vms_db
DB_USERNAME=vms_app
DB_PASSWORD=replace_with_a_local_secret
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
VMS_AUTH_USERNAME=vms.admin@starkgroup.local
VMS_AUTH_PASSWORD=replace_with_a_local_password
VMS_AUTH_TOKEN_TTL_SECONDS=28800
